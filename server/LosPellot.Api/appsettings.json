{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=lospellot.db"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Jwt": {
    "Issuer": "LosPellot.Api",
    "Audience": "LosPellot.Client",
    "SigningKey": "dev-only-signing-key-change-me-before-any-real-deployment-32b+",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  }
}
