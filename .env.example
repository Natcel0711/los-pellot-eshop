# Copy this file to `.env` for local development.
# In production, set the same variables in your Vercel project settings.

# Database. Locally a file; in production your Turso URL (libsql://...).
DATABASE_URL=file:local.db
# Turso auth token (production only). Leave empty for a local file.
DATABASE_AUTH_TOKEN=

# Admin account created by `npm run db:setup`. Use a real password in production.
ADMIN_EMAIL=admin@lospellotled.com
ADMIN_PASSWORD=Admin123!

# Product photos. Vercel sets this automatically once you connect a Blob store.
# Leave empty locally: photos are then saved to ./uploads.
BLOB_READ_WRITE_TOKEN=

# Shipping labels via Shippo (optional). A free shippo_test_... token works.
SHIPPO_API_TOKEN=
# Your real return address, needed for Shippo to quote rates.
SHIP_FROM_NAME=Los Pellot LED and Accessories Distributors
SHIP_FROM_STREET1=
SHIP_FROM_STREET2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_ZIP=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=(787) 555-0142
SHIP_FROM_EMAIL=info@lospellotled.com

# Order confirmation emails via Resend (optional). Leave the key empty locally:
# emails are then printed to the terminal instead of sent.
RESEND_API_KEY=
# Sender, e.g. Los Pellot <pedidos@lospellotled.com>. Its domain must be verified
# in Resend. Until then, leave empty to use Resend's test sender, which only
# delivers to your own Resend account email.
EMAIL_FROM=
